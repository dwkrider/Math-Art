  "definition": {
    "mode": "parametric",
    "fidelity": "exact",
    "note": "tube radius 0.45 about the helix (cos v, sin v, 0.4 v), one turn, the cross-section circle riding in the helix's Frenet normal plane -- the operator defaults.  The builder fits its output to the 2 m cube; verification applies the same fit",
    "x": "cos(v) - 0.45*cos(u)*cos(v) + 0.18*sin(u)*sin(v)/sqrt(1.16)",
    "y": "sin(v) - 0.45*cos(u)*sin(v) - 0.18*sin(u)*cos(v)/sqrt(1.16)",
    "z": "0.4*v + 0.45*sin(u)/sqrt(1.16)",
    "u_range": [
      "0",
      "2*pi"
    ],
    "v_range": [
      "0",
      "2*pi"
    ],
    "periodic_u": true,
    "exactness": "elementary"
  },
