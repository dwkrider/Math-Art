    "x": "((1 - v/(2*pi))*(1 + cos(u)) + 0.37)*cos(2*v)",
    "y": "((1 - v/(2*pi))*(1 + cos(u)) + 0.37)*sin(2*v)",
    "z": "4*v/(2*pi) + sin(u)*(1 - v/(2*pi))",
    "u_range": [
      "0",
      "2*pi"
    ],
    "v_range": [
      "0",
      "2*pi"
    ],
    "periodic_u": true,
    "note": "whorls 2, tube aspect 1, height 4 and mouth opening 0.37 fixed to the operator defaults; v = 2*pi is the apex where the tube collapses to a point",
