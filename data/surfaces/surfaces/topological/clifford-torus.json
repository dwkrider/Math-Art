  "definition": {
    "mode": "parametric",
    "fidelity": "exact",
    "note": "the CIRCLE preset at its default mean colatitude of 90 degrees, i.e. the Hopf preimage of a great circle -- the Clifford torus S1(1/sqrt 2) x S1(1/sqrt 2) in S^3 -- stereographically projected to a torus of revolution; same builder normalisation (and fit) as hopf-torus",
    "x": "cos(u + v)/(sqrt(2) - sin(v))",
    "y": "sin(u + v)/(sqrt(2) - sin(v))",
    "z": "cos(v)/(sqrt(2) - sin(v))",
    "u_range": [
      "0",
      "2*pi"
    ],
    "v_range": [
