    "x": "cos((pi/4 + (17.5*pi/180)*sin(3*u)))*cos(u + v)/(1 - sin((pi/4 + (17.5*pi/180)*sin(3*u)))*sin(v))",
    "y": "cos((pi/4 + (17.5*pi/180)*sin(3*u)))*sin(u + v)/(1 - sin((pi/4 + (17.5*pi/180)*sin(3*u)))*sin(v))",
